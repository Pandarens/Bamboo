// Виджет Bamboo (ТЗ, раздел 14.2).
//
// Компактное окно ~340 x 420, вызывается из трея.
//
// Чего здесь намеренно нет: кнопок «заморозить фоновые», «профиль Игра»
// и «откат». Действий пока не существует — они появятся вместе с брокером
// на этапе 0.4. Нарисовать кнопку, которая ничего не делает, значит соврать
// пользователю о готовности продукта.

struct ProcessRow {
    name: string,
    cpu: string,
    memory: string,
    badge: string,
}

component Card inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> note;

    background: #1e2a24;
    border-radius: 8px;

    VerticalLayout {
        padding: 10px;
        spacing: 2px;

        Text {
            text: root.label;
            font-size: 11px;
            color: #7d8f86;
        }
        Text {
            text: root.value;
            font-size: 20px;
            color: #e8f0ec;
        }
        Text {
            text: root.note;
            font-size: 10px;
            color: #7d8f86;
        }
    }
}

// Переключатель графика: ЦП или ОЗУ.
component SparkTab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback chosen();

    width: 34px;
    height: 18px;
    border-radius: 4px;
    background: root.active ? #2f6f4f : (touch.has-hover ? #24312b : transparent);

    touch := TouchArea {
        clicked => { root.chosen(); }
    }
    Text {
        text: root.label;
        font-size: 10px;
        color: root.active ? #ffffff : #7d8f86;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

export component Widget inherits Window {
    title: "Bamboo";
    // Без системной рамки: виджет — не приложение, и заголовок Windows
    // с кнопками ему не нужен. Закрывается он через меню в трее.
    no-frame: true;
    width: 340px;
    height: 420px;
    background: #141b18;

    in property <string> cpu-value: "—";
    in property <string> cpu-note: "";
    in property <string> memory-value: "—";
    in property <string> memory-note: "";
    in property <string> disk-value: "—";
    in property <string> disk-note: "";
    // Объяснение, почему диск загружен. Пусто — диск свободен.
    in property <string> disk-pressure: "";
    in property <string> status: @tr("запускаюсь");
    in property <string> own-cost: "";
    in property <[ProcessRow]> processes: [];
    // Спарклайн памяти: доли от максимума за окно наблюдения, 0..1.
    in property <[float]> spark: [];
    // Спарклайн процессора: доли от целой машины, 0..1.
    in property <[float]> spark-cpu: [];
    // Что показывает график: процессор или память.
    in-out property <bool> spark-cpu-mode: false;
    in property <bool> pinned: false;
    // Последнее подвисание. Виджет — единственное место, где о нём можно
    // сказать не открывая окна: своих уведомлений у Bamboo нет.
    in property <string> freeze: "";
    in property <string> freeze-culprits: "";

    callback toggle-pin();
    // Открыть окно на списке процессов, отфильтрованном на виновников
    // подвисания. Прочитать имена мало: искать их потом руками в списке
    // из трёхсот строк — работа, которую делать не должен человек.
    callback show-culprits(string);
    // Тянуть виджет можно за строку состояния: своей шапки у него нет.
    callback drag-window();
    // Убрать виджет с экрана. Наблюдение при этом продолжается — Bamboo
    // остаётся в трее, оттуда виджет и возвращается.
    callback close-widget();

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        // Строка состояния. Она же ручка для перетаскивания.
        HorizontalLayout {
            spacing: 8px;

            Rectangle {
                horizontal-stretch: 1;
                TouchArea {
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left
                            && event.kind == PointerEventKind.down) {
                            root.drag-window();
                        }
                    }
                }
                Text {
                    text: root.status;
                    font-size: 11px;
                    color: #7d8f86;
                    vertical-alignment: center;
                    width: 100%;
                }
            }

            Rectangle {
                width: 28px;
                height: 20px;
                border-radius: 5px;
                background: root.pinned ? #2f6f4f : #1e2a24;

                TouchArea {
                    clicked => { root.toggle-pin(); }
                }
                Text {
                    text: "\u{1f4cc}";
                    font-size: 11px;
                }
            }

            // Крестик убирает виджет с экрана, но Bamboo не выключает:
            // наблюдение продолжается, вернуть виджет можно из трея.
            Rectangle {
                width: 28px;
                height: 20px;
                border-radius: 5px;
                background: close-touch.has-hover ? #8f3b3b : #1e2a24;

                close-touch := TouchArea {
                    clicked => { root.close-widget(); }
                }
                Text {
                    text: "×";
                    font-size: 13px;
                    color: #b6c6bd;
                }
            }
        }

        // Две карточки
        HorizontalLayout {
            spacing: 8px;
            Card {
                label: @tr("Процессор");
                value: root.cpu-value;
                note: root.cpu-note;
                horizontal-stretch: 1;
            }
            Card {
                label: @tr("Память");
                value: root.memory-value;
                note: root.memory-note;
                horizontal-stretch: 1;
            }
            Card {
                label: @tr("Диск");
                value: root.disk-value;
                note: root.disk-note;
                horizontal-stretch: 1;
            }
        }

        // Диск упёрся в предел — говорим, из-за чего. Именно этого
        // объяснения не даёт диспетчер задач: он показывает «100%»
        // и оставляет гадать.
        if root.disk-pressure != "": Rectangle {
            background: #2a211c;
            border-radius: 8px;
            VerticalLayout {
                padding: 8px;
                Text {
                    text: root.disk-pressure;
                    font-size: 11px;
                    color: #e0a44a;
                    wrap: word-wrap;
                }
            }
        }

        // Система подвисала. Показываем на виджете, а не только в окне:
        // окна в этот момент на экране нет, а сказать надо тогда же.
        if root.freeze != "": Rectangle {
            background: #2e2320;
            border-radius: 8px;
            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                Text {
                    text: root.freeze;
                    font-size: 11px;
                    color: #d8c4a8;
                    wrap: word-wrap;
                }
                if root.freeze-culprits != "": Rectangle {
                    height: 24px;
                    background: culprits-touch.has-hover ? #3d2f28 : #362a24;
                    border-radius: 5px;
                    culprits-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.show-culprits(root.freeze-culprits); }
                    }
                    Text {
                        text: @tr("Показать их в процессах");
                        font-size: 11px;
                        color: #e0a44a;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // График за последнее время: память или процессор на выбор.
        VerticalLayout {
            spacing: 4px;

            HorizontalLayout {
                spacing: 6px;
                Text {
                    // У памяти шкала растянута по окну наблюдения, у процессора
                    // абсолютная — об этом честно написано прямо здесь, иначе
                    // два графика в одном месте читались бы одинаково.
                    text: root.spark-cpu-mode
                        ? @tr("Процессор, 0–100%")
                        : @tr("Память, размах за последние минуты");
                    font-size: 10px;
                    color: #62736a;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                SparkTab {
                    label: @tr("ЦП");
                    active: root.spark-cpu-mode;
                    chosen => { root.spark-cpu-mode = true; }
                }
                SparkTab {
                    label: @tr("ОЗУ");
                    active: !root.spark-cpu-mode;
                    chosen => { root.spark-cpu-mode = false; }
                }
            }

            Rectangle {
                height: 52px;
                background: #1e2a24;
                border-radius: 8px;

                HorizontalLayout {
                    padding: 6px;
                    spacing: 1px;
                    alignment: end;

                    for value in root.spark-cpu-mode ? root.spark-cpu : root.spark: Rectangle {
                        width: 4px;
                        background: transparent;

                        VerticalLayout {
                            alignment: end;
                            Rectangle {
                                height: max(2px, 40px * value);
                                background: root.spark-cpu-mode ? #4a86c9 : #3f8f66;
                                border-radius: 1px;
                            }
                        }
                    }
                }
            }
        }

        Text {
            text: @tr("Больше всего потребляют");
            font-size: 11px;
            color: #7d8f86;
        }

        // Топ потребителей
        VerticalLayout {
            spacing: 4px;
            vertical-stretch: 1;

            for process in root.processes: Rectangle {
                height: 34px;
                background: #1a231f;
                border-radius: 6px;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;

                        Text {
                            text: process.name;
                            font-size: 12px;
                            color: #e8f0ec;
                            overflow: elide;
                        }
                        Text {
                            text: process.badge;
                            font-size: 9px;
                            color: #7d8f86;
                        }
                    }

                    Text {
                        text: process.cpu;
                        font-size: 12px;
                        color: #b6c6bd;
                        vertical-alignment: center;
                        width: 48px;
                        horizontal-alignment: right;
                    }
                    Text {
                        text: process.memory;
                        font-size: 12px;
                        color: #b6c6bd;
                        vertical-alignment: center;
                        width: 66px;
                        horizontal-alignment: right;
                    }
                }
            }
        }

        Text {
            text: root.own-cost;
            font-size: 10px;
            color: #62736a;
        }

        Text {
            text: @tr("Bamboo пока только наблюдает. Действия появятся на этапе 0.4.");
            font-size: 10px;
            color: #62736a;
            wrap: word-wrap;
        }
    }
}
