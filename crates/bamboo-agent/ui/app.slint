// Единая точка сборки интерфейса.
//
// Slint компилирует один входной файл; несколько окон подключаются
// импортом. Так и виджет, и главное окно попадают в одну генерацию,
// а их структуры данных — в один сгенерированный модуль.

import { Widget } from "widget.slint";
import { MainWindow } from "main_window.slint";

export { Widget, MainWindow }
