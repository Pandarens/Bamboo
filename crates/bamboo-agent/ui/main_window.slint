// Главное окно Bamboo (ТЗ, раздел 14.3).
//
// Слева навигация по разделам, справа содержимое. Разделы, для которых
// данные уже есть, наполнены живьём; остальные честно помечены как
// готовящиеся, а не показывают пустоту под видом готовности.

struct MainProcessRow {
    name: string,
    pid: string,
    cpu: string,
    memory: string,
    threads: string,
    badge: string,
    // Рост памяти: «+40 МБ/ч». Пусто, если память не растёт.
    growth: string,
    // Рост дотянул до подозрения на утечку — красим строку.
    leak: bool,
    // «не отвечает» или пусто.
    state: string,
    hung: bool,
    // Нагрузка на диск: «12.4 МБ/с» либо пусто.
    disk: string,
}

// Накопитель в обзоре.
struct DiskLoadRow {
    name: string,
    busy: string,
    speed: string,
    queue: string,
    // Диск упирается в предел — подсвечиваем.
    saturated: bool,
    // Доля занятости 0..1 для полоски.
    fill: float,
}

// Файл подкачки в обзоре.
struct PagefileRow {
    where: string,
    used: string,
    peak: string,
    fill: float,
}

struct DriveRow {
    title: string,
    facts: string,
    verdict: string,
}

struct WakeRow {
    when: string,
    source: string,
}

struct JournalRow {
    when: string,
    action: string,
    target: string,
    status: string,
}

component NavButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback chosen();

    height: 34px;
    border-radius: 6px;
    background: active ? #2f6f4f : (touch.has-hover ? #1e2a24 : transparent);

    touch := TouchArea {
        clicked => { root.chosen(); }
    }
    Text {
        x: 12px;
        vertical-alignment: center;
        text: root.label;
        color: active ? #ffffff : #b6c6bd;
        font-size: 13px;
    }
}

// Заголовок столбца: щелчок сортирует, повторный щелчок разворачивает
// порядок. Стрелка показывает, по какому столбцу идёт сортировка.
component ColumnHeader inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> descending;
    callback chosen();

    height: 20px;
    background: touch.has-hover ? #1e2a24 : transparent;
    border-radius: 4px;

    touch := TouchArea {
        clicked => { root.chosen(); }
    }
    HorizontalLayout {
        padding-left: 4px; padding-right: 4px; spacing: 3px;
        Text {
            text: root.label;
            font-size: 11px;
            color: root.active ? #e8f0ec : #7d8f86;
            vertical-alignment: center;
        }
        Text {
            text: root.active ? (root.descending ? "▼" : "▲") : "";
            font-size: 8px;
            color: #7d8f86;
            vertical-alignment: center;
        }
    }
}

// Маленькая кнопка действия в строке процесса.
component RowButton inherits Rectangle {
    in property <string> label;
    in property <bool> danger;
    callback pressed();

    width: 78px;
    height: 22px;
    border-radius: 4px;
    background: touch.has-hover ? (root.danger ? #8f3b3b : #2f6f4f) : #24312b;

    touch := TouchArea {
        clicked => { root.pressed(); }
    }
    Text {
        text: root.label;
        font-size: 10px;
        color: #e8f0ec;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
    }
}

// Невидимая полоса по краю окна: за неё Windows меняет размер.
// Своей рамки у окна нет, значит и границ для растягивания нет —
// возвращаем их руками.
component ResizeGrip inherits Rectangle {
    in property <int> edge;
    in property <MouseCursor> shape;
    callback grabbed(int);

    background: transparent;
    TouchArea {
        mouse-cursor: root.shape;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.grabbed(root.edge);
            }
        }
    }
}

// Кнопка в своей шапке окна: свернуть, закрыть.
component CaptionButton inherits Rectangle {
    in property <string> label;
    in property <bool> danger;
    callback pressed();

    width: 40px;
    border-radius: 4px;
    background: touch.has-hover ? (root.danger ? #8f3b3b : #24312b) : transparent;

    touch := TouchArea {
        clicked => { root.pressed(); }
    }
    Text {
        text: root.label;
        font-size: 12px;
        color: #b6c6bd;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

export component MainWindow inherits Window {
    title: "Bamboo";
    // Своя рамка вместо системной (ТЗ, раздел 14.3): заголовок и кнопки
    // рисуем сами, чтобы окно выглядело частью Bamboo, а не диалогом Windows.
    no-frame: true;
    // Шире прежнего: в таблице процессов прибавились столбец роста памяти
    // и кнопки действий.
    preferred-width: 1080px;
    preferred-height: 640px;
    min-width: 900px;
    min-height: 480px;
    background: #141b18;

    // 0 обзор, 1 процессы, 2 диск, 3 питание, 4 журнал, 5 прочее
    in-out property <int> section: 0;

    in property <string> cpu-summary: "—";
    in property <string> memory-summary: "—";
    in property <string> process-summary: "—";
    in property <string> learning: "";
    in property <[MainProcessRow]> processes: [];
    in property <[DriveRow]> drives: [];
    in property <[WakeRow]> wakes: [];
    in property <[JournalRow]> journal: [];
    in property <[DiskLoadRow]> disk-load: [];
    in property <[PagefileRow]> pagefiles: [];
    in property <string> disk-pressure: "";
    in property <string> disk-note: "";
    in property <string> power-note: "";
    in property <string> journal-note: "";

    // Сортировка таблицы процессов: индекс столбца и направление.
    // 0 имя, 1 PID, 2 CPU, 3 память, 4 потоки, 5 рост памяти.
    in-out property <int> sort-column: 2;
    in-out property <bool> sort-descending: true;
    // Что случилось с последним действием — показываем под таблицей.
    in property <string> action-note: "";

    callback refresh();
    // Пересортировать по столбцу. Rust перестраивает список и возвращает
    // его обратно: сортировать надо по числам, а в интерфейсе только текст.
    callback sort-by(int);
    // Применить действие к процессу: PID и код действия (0 экономичный
    // режим, 1 понизить приоритет памяти).
    callback apply-action(string, int);
    // Завершить процесс. Спрашиваем дважды: операция необратима.
    callback terminate-process(string);
    // PID, для которого сейчас показан вопрос «точно завершить?».
    in-out property <string> confirming: "";

    callback minimize-window();
    callback close-window();
    // Начать перетаскивание окна за шапку.
    callback drag-window();
    // Начать растягивание окна за край. Номер края: 0 левый, 1 правый,
    // 2 верх, 3 верх-лево, 4 верх-право, 5 низ, 6 низ-лево, 7 низ-право.
    callback resize-window(int);

    // Всё содержимое лежит внутри, а полосы захвата — поверх него по краям.
    Rectangle {

    VerticalLayout {

    // --- Своя шапка окна ---
    Rectangle {
        height: 36px;
        background: #0e1512;

        // Тянем окно за шапку. Перетаскивание делает Windows по нашей
        // просьбе, поэтому мышь не «убегает» от окна при быстром движении.
        TouchArea {
            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    root.drag-window();
                }
            }
        }

        HorizontalLayout {
            padding-left: 12px; spacing: 4px;
            Text {
                text: "Bamboo — наблюдатель за системой";
                font-size: 12px;
                color: #b6c6bd;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            CaptionButton {
                label: "—";
                pressed => { root.minimize-window(); }
            }
            CaptionButton {
                // Знак умножения, а не «✕»: последний есть не во всех
                // шрифтах и на живой машине отрисовался пустотой.
                label: "×";
                danger: true;
                pressed => { root.close-window(); }
            }
        }
    }

    HorizontalLayout {
        // Навигация
        Rectangle {
            width: 180px;
            background: #0e1512;

            VerticalLayout {
                padding: 12px;
                spacing: 4px;

                Text {
                    text: "Bamboo";
                    font-size: 18px;
                    color: #e8f0ec;
                    horizontal-alignment: left;
                }
                Rectangle { height: 12px; }

                NavButton {
                    label: "Обзор";
                    active: root.section == 0;
                    chosen => { root.section = 0; }
                }
                NavButton {
                    label: "Процессы";
                    active: root.section == 1;
                    chosen => { root.section = 1; }
                }
                NavButton {
                    label: "Диск";
                    active: root.section == 2;
                    chosen => { root.section = 2; root.refresh(); }
                }
                NavButton {
                    label: "Питание";
                    active: root.section == 3;
                    chosen => { root.section = 3; root.refresh(); }
                }
                NavButton {
                    label: "Журнал";
                    active: root.section == 4;
                    chosen => { root.section = 4; root.refresh(); }
                }
                NavButton {
                    label: "Ещё";
                    active: root.section == 5;
                    chosen => { root.section = 5; }
                }

                Rectangle { vertical-stretch: 1; }

                Text {
                    text: root.learning;
                    font-size: 10px;
                    color: #62736a;
                    wrap: word-wrap;
                }
            }
        }

        // Содержимое
        Rectangle {
            background: #141b18;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                // --- Обзор ---
                if root.section == 0: VerticalLayout {
                    spacing: 10px;
                    Text { text: "Обзор"; font-size: 20px; color: #e8f0ec; }

                    HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            background: #1e2a24; border-radius: 8px; height: 78px;
                            VerticalLayout {
                                padding: 12px;
                                Text { text: "Процессор"; font-size: 11px; color: #7d8f86; }
                                Text { text: root.cpu-summary; font-size: 22px; color: #e8f0ec; }
                            }
                        }
                        Rectangle {
                            background: #1e2a24; border-radius: 8px; height: 78px;
                            VerticalLayout {
                                padding: 12px;
                                Text { text: "Память"; font-size: 11px; color: #7d8f86; }
                                Text { text: root.memory-summary; font-size: 22px; color: #e8f0ec; }
                            }
                        }
                        Rectangle {
                            background: #1e2a24; border-radius: 8px; height: 78px;
                            VerticalLayout {
                                padding: 12px;
                                Text { text: "Процессов"; font-size: 11px; color: #7d8f86; }
                                Text { text: root.process-summary; font-size: 22px; color: #e8f0ec; }
                            }
                        }
                    }

                    // --- Накопители ---
                    Text { text: "Накопители"; font-size: 14px; color: #e8f0ec; }
                    if root.disk-pressure != "": Rectangle {
                        background: #2a211c; border-radius: 8px;
                        VerticalLayout {
                            padding: 10px;
                            Text {
                                text: root.disk-pressure;
                                font-size: 12px; color: #e0a44a; wrap: word-wrap;
                            }
                        }
                    }
                    for disk in root.disk-load: Rectangle {
                        background: #1e2a24; border-radius: 8px;
                        VerticalLayout {
                            padding: 10px; spacing: 5px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: disk.name; font-size: 12px; color: #e8f0ec;
                                    vertical-alignment: center; horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Text {
                                    text: disk.busy;
                                    font-size: 12px;
                                    color: disk.saturated ? #e0724a : #b6c6bd;
                                    vertical-alignment: center;
                                }
                            }
                            // Полоска занятости: та же цифра, но видно сразу.
                            Rectangle {
                                height: 6px; background: #141b18; border-radius: 3px;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * disk.fill;
                                    height: parent.height;
                                    background: disk.saturated ? #c25a3a : #3f8f66;
                                    border-radius: 3px;
                                }
                            }
                            Text {
                                text: disk.speed + "   в очереди: " + disk.queue;
                                font-size: 11px; color: #7d8f86;
                            }
                        }
                    }

                    // --- Подкачка ---
                    Text { text: "Файл подкачки"; font-size: 14px; color: #e8f0ec; }
                    if root.pagefiles.length == 0: Text {
                        text: "Подкачка отключена — Windows держит всё в оперативной памяти.";
                        font-size: 11px; color: #7d8f86; wrap: word-wrap;
                    }
                    for file in root.pagefiles: Rectangle {
                        background: #1e2a24; border-radius: 8px;
                        VerticalLayout {
                            padding: 10px; spacing: 5px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: file.where; font-size: 12px; color: #e8f0ec;
                                    vertical-alignment: center; horizontal-stretch: 1;
                                }
                                Text {
                                    text: file.used; font-size: 12px; color: #b6c6bd;
                                    vertical-alignment: center;
                                }
                            }
                            Rectangle {
                                height: 6px; background: #141b18; border-radius: 3px;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * file.fill;
                                    height: parent.height;
                                    background: #4a86c9;
                                    border-radius: 3px;
                                }
                            }
                            Text {
                                text: file.peak;
                                font-size: 11px; color: #7d8f86;
                            }
                        }
                    }

                    Text {
                        text: "Bamboo наблюдает за системой и объясняет причины деградации. "
                            + "Действия применяются только по вашему решению и всегда обратимы.";
                        font-size: 12px; color: #7d8f86; wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                // --- Процессы ---
                if root.section == 1: VerticalLayout {
                    spacing: 8px;
                    Text { text: "Процессы"; font-size: 20px; color: #e8f0ec; }
                    Text {
                        text: "Столбец «Рост памяти» показывает то, чего нет в диспетчере задач: "
                            + "не сколько памяти занято сейчас, а растёт ли она и как быстро. "
                            + "Щёлкните по заголовку столбца, чтобы отсортировать. "
                            + "«Эконом» уводит процесс на энергоэффективные ядра, «Память ↓» "
                            + "понижает приоритет его памяти — оба действия записываются в журнал "
                            + "и обратимы. «Завершить» — единственное необратимое действие: "
                            + "несохранённые данные пропадут, поэтому кнопка спрашивает второй раз. "
                            + "Показаны первые 80 строк: сортировка идёт по всем процессам, "
                            + "обрезается уже результат.";
                        font-size: 11px; color: #62736a; wrap: word-wrap;
                    }
                    HorizontalLayout {
                        padding-left: 4px; padding-right: 4px; spacing: 4px;
                        ColumnHeader {
                            label: "Процесс"; horizontal-stretch: 1;
                            active: root.sort-column == 0; descending: root.sort-descending;
                            chosen => { root.sort-by(0); }
                        }
                        ColumnHeader {
                            label: "PID"; width: 64px;
                            active: root.sort-column == 1; descending: root.sort-descending;
                            chosen => { root.sort-by(1); }
                        }
                        ColumnHeader {
                            label: "CPU"; width: 64px;
                            active: root.sort-column == 2; descending: root.sort-descending;
                            chosen => { root.sort-by(2); }
                        }
                        ColumnHeader {
                            label: "Память"; width: 90px;
                            active: root.sort-column == 3; descending: root.sort-descending;
                            chosen => { root.sort-by(3); }
                        }
                        ColumnHeader {
                            label: "Потоки"; width: 60px;
                            active: root.sort-column == 4; descending: root.sort-descending;
                            chosen => { root.sort-by(4); }
                        }
                        ColumnHeader {
                            label: "Рост памяти"; width: 110px;
                            active: root.sort-column == 5; descending: root.sort-descending;
                            chosen => { root.sort-by(5); }
                        }
                        ColumnHeader {
                            label: "Диск"; width: 92px;
                            active: root.sort-column == 7; descending: root.sort-descending;
                            chosen => { root.sort-by(7); }
                        }
                        ColumnHeader {
                            label: "Состояние"; width: 92px;
                            active: root.sort-column == 6; descending: root.sort-descending;
                            chosen => { root.sort-by(6); }
                        }
                        Rectangle { width: 250px; }
                    }
                    Flickable {
                        VerticalLayout {
                            spacing: 2px;
                            for process in root.processes: Rectangle {
                                height: 30px;
                                background: row-touch.has-hover ? #22302a : #1a231f;
                                border-radius: 5px;

                                row-touch := TouchArea { }

                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px; spacing: 4px;
                                    Text { text: process.name; color: #e8f0ec; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                    Text { text: process.pid; color: #b6c6bd; font-size: 12px; vertical-alignment: center; width: 64px; }
                                    Text { text: process.cpu; color: #b6c6bd; font-size: 12px; vertical-alignment: center; width: 64px; }
                                    Text { text: process.memory; color: #b6c6bd; font-size: 12px; vertical-alignment: center; width: 90px; }
                                    Text { text: process.threads; color: #b6c6bd; font-size: 12px; vertical-alignment: center; width: 60px; }
                                    // Подозрение на утечку выделяем цветом; измеренная
                                    // скорость без вердикта остаётся нейтральной.
                                    Text {
                                        text: process.growth;
                                        color: process.leak ? #e0a44a : #7d8f86;
                                        font-size: 11px; vertical-alignment: center; width: 110px;
                                    }
                                    // Действия видны всегда, а не по наведению:
                                    // кнопку, которую надо сперва найти мышью,
                                    // всё равно что не существует. Оба действия
                                    // настоящие и обратимые — никакой «очистки
                                    // памяти», это placebo и его тут не будет.
                                    Text {
                                        text: process.disk;
                                        color: #7fb0d8;
                                        font-size: 11px; vertical-alignment: center; width: 92px;
                                    }
                                    // Зависшее окно — единственное состояние,
                                    // о котором стоит сообщать; «отвечает»
                                    // у всех подряд было бы шумом.
                                    Text {
                                        text: process.state;
                                        color: #e0724a;
                                        font-size: 11px; vertical-alignment: center; width: 92px;
                                    }
                                    Rectangle {
                                        width: 250px;
                                        HorizontalLayout {
                                            spacing: 4px;
                                            alignment: end;
                                            RowButton {
                                                label: "Эконом";
                                                pressed => { root.apply-action(process.pid, 0); }
                                            }
                                            RowButton {
                                                label: "Память ↓";
                                                pressed => { root.apply-action(process.pid, 1); }
                                            }
                                            // Завершение необратимо, поэтому
                                            // спрашиваем второй раз прямо на
                                            // кнопке — модальное окно тут
                                            // только мешало бы.
                                            RowButton {
                                                label: root.confirming == process.pid ? "Точно?" : "Завершить";
                                                danger: true;
                                                pressed => {
                                                    if (root.confirming == process.pid) {
                                                        root.confirming = "";
                                                        root.terminate-process(process.pid);
                                                    } else {
                                                        root.confirming = process.pid;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Text {
                        text: root.action-note;
                        font-size: 11px; color: #9fb3a8; wrap: word-wrap;
                    }
                }

                // --- Диск ---
                if root.section == 2: VerticalLayout {
                    spacing: 8px;
                    Text { text: "Диск"; font-size: 20px; color: #e8f0ec; }
                    for drive in root.drives: Rectangle {
                        background: #1e2a24; border-radius: 8px;
                        VerticalLayout {
                            padding: 12px; spacing: 4px;
                            Text { text: drive.title; font-size: 14px; color: #e8f0ec; }
                            Text { text: drive.facts; font-size: 11px; color: #7d8f86; }
                            Text { text: drive.verdict; font-size: 12px; color: #b6c6bd; wrap: word-wrap; }
                        }
                    }
                    Text { text: root.disk-note; font-size: 11px; color: #62736a; wrap: word-wrap; }
                    Rectangle { vertical-stretch: 1; }
                }

                // --- Питание ---
                if root.section == 3: VerticalLayout {
                    spacing: 8px;
                    Text { text: "Питание"; font-size: 20px; color: #e8f0ec; }
                    for wake in root.wakes: Rectangle {
                        height: 30px; background: #1a231f; border-radius: 5px;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px; spacing: 8px;
                            Text { text: wake.when; color: #7d8f86; font-size: 12px; vertical-alignment: center; width: 190px; }
                            Text { text: wake.source; color: #e8f0ec; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                        }
                    }
                    Text { text: root.power-note; font-size: 11px; color: #62736a; wrap: word-wrap; }
                    Rectangle { vertical-stretch: 1; }
                }

                // --- Журнал ---
                if root.section == 4: VerticalLayout {
                    spacing: 8px;
                    Text { text: "Журнал действий"; font-size: 20px; color: #e8f0ec; }
                    for entry in root.journal: Rectangle {
                        height: 30px; background: #1a231f; border-radius: 5px;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px; spacing: 6px;
                            Text { text: entry.when; color: #7d8f86; font-size: 11px; vertical-alignment: center; width: 150px; }
                            Text { text: entry.action; color: #e8f0ec; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            Text { text: entry.target; color: #b6c6bd; font-size: 12px; vertical-alignment: center; width: 180px; overflow: elide; }
                            Text { text: entry.status; color: #7d8f86; font-size: 11px; vertical-alignment: center; width: 100px; }
                        }
                    }
                    Text { text: root.journal-note; font-size: 11px; color: #62736a; wrap: word-wrap; }
                    Rectangle { vertical-stretch: 1; }
                }

                // --- Ещё ---
                if root.section == 5: VerticalLayout {
                    spacing: 8px;
                    Text { text: "Ещё"; font-size: 20px; color: #e8f0ec; }
                    Text {
                        text: "Разделы «Загрузка», «Автозапуск», «Отчёты» и «Настройки» "
                            + "готовятся. Данные для них уже собираются — их можно посмотреть "
                            + "через отладочную утилиту: bamboo boot, bamboo power, bamboo disk.";
                        font-size: 12px; color: #7d8f86; wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
    }

    }

    // Полосы захвата по периметру. Ширина в четыре пиксела — как у обычной
    // рамки Windows: достаточно, чтобы попасть мышью, и не настолько много,
    // чтобы мешать нажимать на содержимое у края.
    ResizeGrip {
        edge: 0; shape: MouseCursor.ew-resize;
        x: 0; y: 4px; width: 4px; height: parent.height - 8px;
        grabbed(edge) => { root.resize-window(edge); }
    }
    ResizeGrip {
        edge: 1; shape: MouseCursor.ew-resize;
        x: parent.width - 4px; y: 4px; width: 4px; height: parent.height - 8px;
        grabbed(edge) => { root.resize-window(edge); }
    }
    ResizeGrip {
        edge: 2; shape: MouseCursor.ns-resize;
        x: 4px; y: 0; width: parent.width - 8px; height: 4px;
        grabbed(edge) => { root.resize-window(edge); }
    }
    ResizeGrip {
        edge: 5; shape: MouseCursor.ns-resize;
        x: 4px; y: parent.height - 4px; width: parent.width - 8px; height: 4px;
        grabbed(edge) => { root.resize-window(edge); }
    }
    ResizeGrip {
        edge: 3; shape: MouseCursor.nwse-resize;
        x: 0; y: 0; width: 8px; height: 8px;
        grabbed(edge) => { root.resize-window(edge); }
    }
    ResizeGrip {
        edge: 4; shape: MouseCursor.nesw-resize;
        x: parent.width - 8px; y: 0; width: 8px; height: 8px;
        grabbed(edge) => { root.resize-window(edge); }
    }
    ResizeGrip {
        edge: 6; shape: MouseCursor.nesw-resize;
        x: 0; y: parent.height - 8px; width: 8px; height: 8px;
        grabbed(edge) => { root.resize-window(edge); }
    }
    ResizeGrip {
        edge: 7; shape: MouseCursor.nwse-resize;
        x: parent.width - 8px; y: parent.height - 8px; width: 8px; height: 8px;
        grabbed(edge) => { root.resize-window(edge); }
    }

    }
}
