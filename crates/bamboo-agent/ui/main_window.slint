// Главное окно Bamboo (ТЗ, раздел 14.3).
//
// Слева навигация по разделам, справа содержимое. Разделы, для которых
// данные уже есть, наполнены живьём; остальные честно помечены как
// готовящиеся, а не показывают пустоту под видом готовности.

struct MainProcessRow {
    name: string,
    pid: string,
    cpu: string,
    memory: string,
    threads: string,
    badge: string,
    // Рост памяти: «+40 МБ/ч». Пусто, если память не растёт.
    growth: string,
    // Рост дотянул до подозрения на утечку — красим строку.
    leak: bool,
    // «не отвечает» или пусто.
    state: string,
    hung: bool,
    // Нагрузка на диск: «12.4 МБ/с» либо пусто.
    disk: string,
    // Диску этого процесса мы придержали скорость.
    throttled: bool,
    // Группа из нескольких процессов.
    is-group: bool,
    // Группа развёрнута.
    expanded: bool,
    // Процесс внутри развёрнутой группы.
    is-member: bool,
    // Номера процессов группы через запятую.
    member-pids: string,
    // Что Bamboo уже применил: «эконом, память ↓».
    applied: string,
}

// Накопитель в обзоре.
struct DiskLoadRow {
    name: string,
    busy: string,
    speed: string,
    queue: string,
    // Диск упирается в предел — подсвечиваем.
    saturated: bool,
    // Доля занятости 0..1 для полоски.
    fill: float,
}

// Предложение по оптимизации.
struct SuggestionRow {
    pid: string,
    title: string,
    reason: string,
    effect: string,
    // Пусто — предложение без действия, только наблюдение.
    button: string,
    action: int,
}

// Раздел диска в обзоре.
struct VolumeRow {
    title: string,
    space: string,
    fill: float,
    // Места так мало, что страдает скорость записи.
    cramped: bool,
}

// Файл подкачки в обзоре.
struct PagefileRow {
    where: string,
    used: string,
    peak: string,
    fill: float,
}

// Кто прямо сейчас работает с накопителем.
// Расширение браузера.
struct ExtensionRow {
    name: string,
    browser: string,
}

// Что можно выбрать для анализа: установленная игра либо запущенная
// программа. Одним списком, потому что человеку это одно и то же — то,
// за чем он хочет понаблюдать.
// Загрузка системы.
// Строка отчёта о собственном бюджете.
struct BudgetRow {
    metric: string,
    measured: string,
    limit: string,
    // 0 — судить рано, 1 — уложились, 2 — вышли за предел.
    state: int,
}

struct BootRow {
    when: string,
    total: string,
    phases: string,
    slower: string,
    degraded: bool,
}

// Запись автозагрузки.
struct StartupRow {
    name: string,
    command: string,
    enabled: bool,
}

struct TargetRow {
    // Что показать: «BitCraft Online» либо «chrome.exe».
    label: string,
    // Что записывать: имя исполняемого файла.
    exe: string,
    // Откуда: «Steam», «Epic Games», «запущено сейчас».
    source: string,
}

struct DiskUserRow {
    name: string,
    rate: string,
    share: float,
}

struct DriveRow {
    title: string,
    facts: string,
    verdict: string,
}

struct WakeRow {
    when: string,
    source: string,
}

struct JournalRow {
    when: string,
    action: string,
    target: string,
    status: string,
}

component NavButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback chosen();

    height: 34px;
    border-radius: 6px;
    background: active ? #2f6f4f : (touch.has-hover ? #1e2a24 : transparent);

    touch := TouchArea {
        clicked => { root.chosen(); }
    }
    Text {
        x: 12px;
        vertical-alignment: center;
        text: root.label;
        color: active ? #ffffff : #b6c6bd;
        font-size: 13px;
    }
}

// Заголовок столбца: щелчок сортирует, повторный щелчок разворачивает
// порядок. Стрелка показывает, по какому столбцу идёт сортировка.
component ColumnHeader inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> descending;
    // Числовые столбцы прижимаем вправо — как и сами числа под ними.
    in property <bool> align-right;
    callback chosen();

    height: 20px;
    background: touch.has-hover ? #1e2a24 : transparent;
    border-radius: 4px;

    touch := TouchArea {
        clicked => { root.chosen(); }
    }
    HorizontalLayout {
        padding-left: 4px; padding-right: 4px; spacing: 3px;
        alignment: root.align-right ? end : start;
        Text {
            text: root.label;
            font-size: 11px;
            color: root.active ? #e8f0ec : #7d8f86;
            vertical-alignment: center;
        }
        Text {
            text: root.active ? (root.descending ? "▼" : "▲") : "";
            font-size: 8px;
            color: #7d8f86;
            vertical-alignment: center;
        }
    }
}

// Маленькая кнопка действия в строке процесса.
component RowButton inherits Rectangle {
    in property <string> label;
    in property <bool> danger;
    callback pressed();

    width: 72px;
    height: 24px;
    border-radius: 4px;
    // При наведении кнопка светлеет, а не темнеет: раньше опасная кнопка
    // уходила в тёмно-красный и выглядела погасшей.
    background: touch.pressed
        ? (root.danger ? #b04a4a : #3f8f66)
        : (touch.has-hover
            ? (root.danger ? #a04444 : #38805c)
            : (root.danger ? #3a2a2a : #2a3830));
    border-width: 1px;
    border-color: touch.has-hover
        ? (root.danger ? #c25a5a : #4aa377)
        : (root.danger ? #573c3c : #35473d);

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.pressed(); }
    }
    Text {
        text: root.label;
        font-size: 10px;
        color: touch.has-hover ? #ffffff : #d5e2da;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
    }
}

// Невидимая полоса по краю окна: за неё Windows меняет размер.
// Своей рамки у окна нет, значит и границ для растягивания нет —
// возвращаем их руками.
// График записи: столбики по времени слева направо.
//
// Столбиками, а не линией: линию в Slint пришлось бы рисовать через Path
// с построением строки пути, а столбики — обычные прямоугольники, которые
// программный рендерер отрисует дёшево. Читаются они не хуже.
component Chart inherits Rectangle {
    in property <string> title;
    in property <string> scale;
    in property <[float]> points: [];
    in property <color> tint: #6fb58a;

    background: #1a231f;
    border-radius: 8px;
    height: 118px;

    VerticalLayout {
        padding: 10px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.title;
                font-size: 12px; color: #e8f0ec;
                horizontal-stretch: 1;
            }
            Text {
                text: root.scale;
                font-size: 10px; color: #62736a;
                vertical-alignment: center;
            }
        }

        plot := Rectangle {
            background: #141b18;
            border-radius: 4px;
            vertical-stretch: 1;
            clip: true;

            // Столбики ставим по координатам, а не раскладкой. Раскладка
            // считает свою ширину по детям, а ширина столбика считается
            // от неё — выходит петля, и Slint такое не собирает.
            for value[index] in root.points: Rectangle {
                property <length> step: plot.width / max(root.points.length, 1);
                x: index * self.step;
                width: max(1px, self.step - 1px);
                // Ноль всё равно рисуем полоской в пиксель: пустое место
                // читалось бы как «данных нет», а данные есть и в них ноль.
                height: max(1px, (plot.height - 4px) * value);
                y: plot.height - 2px - self.height;
                background: root.tint;
                border-radius: 1px;
            }
        }
    }
}

component ResizeGrip inherits Rectangle {
    in property <int> edge;
    in property <MouseCursor> shape;
    callback grabbed(int);

    background: transparent;
    TouchArea {
        mouse-cursor: root.shape;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.grabbed(root.edge);
            }
        }
    }
}

// Пункт контекстного меню.
component MenuRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> danger;
    callback chosen();

    height: 30px;
    background: touch.has-hover
        ? (root.danger ? #4a2a2a : #2a3830)
        : transparent;

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.chosen(); }
    }
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px; spacing: 8px;
        Text {
            text: root.label;
            font-size: 12px;
            color: root.danger ? #e08a8a : #e8f0ec;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.hint;
            font-size: 10px;
            color: #7d8f86;
            vertical-alignment: center;
        }
    }
}

// Кнопка в своей шапке окна: свернуть, закрыть.
component CaptionButton inherits Rectangle {
    in property <string> label;
    in property <bool> danger;
    callback pressed();

    width: 40px;
    border-radius: 4px;
    background: touch.has-hover ? (root.danger ? #8f3b3b : #24312b) : transparent;

    touch := TouchArea {
        clicked => { root.pressed(); }
    }
    Text {
        text: root.label;
        font-size: 12px;
        color: #b6c6bd;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

export component MainWindow inherits Window {
    title: "Bamboo";
    // Своя рамка вместо системной (ТЗ, раздел 14.3): заголовок и кнопки
    // рисуем сами, чтобы окно выглядело частью Bamboo, а не диалогом Windows.
    no-frame: true;
    // Шире прежнего: в таблице процессов прибавились столбец роста памяти
    // и кнопки действий.
    preferred-width: 1420px;
    preferred-height: 640px;
    min-width: 1180px;
    min-height: 480px;
    background: #141b18;

    // 0 обзор, 1 процессы, 2 диск, 3 питание, 4 журнал, 5 прочее
    in-out property <int> section: 0;

    in property <string> cpu-summary: "—";
    in property <string> memory-summary: "—";
    in property <string> process-summary: "—";
    in property <string> learning: "";
    in property <[MainProcessRow]> processes: [];
    in property <[DriveRow]> drives: [];
    in property <[WakeRow]> wakes: [];
    in property <[JournalRow]> journal: [];
    in property <[DiskLoadRow]> disk-load: [];
    in property <[PagefileRow]> pagefiles: [];
    in property <[VolumeRow]> volumes: [];
    in property <[SuggestionRow]> suggestions: [];
    in property <string> suggestions-note: "";
    in property <string> disk-pressure: "";
    // Объяснение работы ядра с диском: тот самый случай «виноват System».
    in property <string> system-io: "";
    in property <string> freeze: "";
    // Имена виновников через запятую. Пусто — переходить не к кому:
    // у времени в драйверах виновника среди процессов нет.
    in property <string> freeze-culprits: "";
    // Обновление. Пусто — обновляться не на что, и полоса не показывается:
    // напоминать не о чем.
    in property <string> update-version: "";
    in property <string> update-notes: "";
    in property <string> update-status: "";
    in property <bool> update-busy: false;
    in property <string> app-version: "";
    in-out property <string> language: "ru";
    callback toggle-language();
    in property <string> history-note: "";
    in property <[BootRow]> boots: [];
    in property <[BudgetRow]> budget: [];
    in property <string> budget-verdict: "";
    in property <string> boot-note: "";
    in property <[StartupRow]> startup: [];
    in property <string> startup-note: "";
    // Переключение записи автозагрузки: имя и чего добиваемся.
    callback toggle-startup(string, bool);
    in property <string> report-text: "";
    in property <string> report-note: "";
    in-out property <int> report-format: 0;
    callback build-report();
    callback save-report();
    callback install-update();
    callback check-update();
    in property <[DiskUserRow]> disk-users: [];
    in property <string> disk-users-note: "";
    in property <[ExtensionRow]> extensions: [];
    // Запись наблюдения за программой.
    in-out property <string> record-app: "";
    in property <bool> recording: false;
    in property <string> record-status: "";
    in property <string> record-verdict: "";
    in property <[float]> record-cpu: [];
    in property <[float]> record-memory: [];
    in property <[float]> record-gpu: [];
    in property <[float]> record-disk: [];
    in property <bool> record-has-gpu: false;
    in property <string> record-scale-cpu: "";
    in property <string> record-scale-memory: "";
    in property <string> record-scale-disk: "";
    callback toggle-recording(string);
    in property <[TargetRow]> targets: [];
    in-out property <bool> targets-open: false;
    in property <string> targets-note: "";
    in property <string> extensions-note: "";
    in property <bool> autopilot: false;
    in property <string> autopilot-status: "";
    callback toggle-autopilot();
    // Игровой режим включён.
    in-out property <bool> game-mode: false;
    // Bamboo запускается вместе с Windows.
    in-out property <bool> autostart: false;
    // Показывать виджет сразу при запуске.
    in-out property <bool> show-widget-on-start: false;
    // Служба, вернувшая завершённый процесс. Пусто — предлагать нечего.
    in-out property <string> culprit-service: "";
    // Сколько времени идёт наблюдение — от этого зависит, что мы можем
    // сказать про рост памяти.
    in property <string> watch-status: "";
    in property <string> disk-note: "";
    in property <string> power-note: "";
    in property <string> journal-note: "";

    // Сортировка таблицы процессов: индекс столбца и направление.
    // 0 имя, 1 PID, 2 CPU, 3 память, 4 потоки, 5 рост памяти.
    in-out property <int> sort-column: 2;
    in-out property <bool> sort-descending: true;
    // Схлопывать процессы одной программы в строку. По умолчанию да:
    // двадцать вкладок Chrome по отдельности мало о чём говорят.
    in-out property <bool> grouped: true;
    // Имена развёрнутых групп, разделённые символом с кодом 1: он не
    // встречается в именах процессов, поэтому подойдёт как разделитель.
    in-out property <string> expanded-groups: "";
    // Фильтр по имени процесса.
    in-out property <string> filter: "";
    // Процесс, для которого открыто контекстное меню.
    in-out property <string> menu-pid: "";
    in-out property <string> menu-name: "";
    in-out property <string> menu-pids: "";
    in-out property <bool> menu-group: false;
    in-out property <bool> menu-throttled: false;
    // Где открыть меню. Без этих координат PopupWindow встаёт в угол окна:
    // он позиционируется относительно родителя, а родитель у него — окно.
    in-out property <length> menu-x: 0px;
    in-out property <length> menu-y: 0px;
    // Что случилось с последним действием — показываем под таблицей.
    in property <string> action-note: "";

    // Открыть меню строки. Отдельным вызовом, потому что зовут его две
    // области нажатия: сама строка и имя группы поверх неё. Имя перекрывает
    // строку целиком, и без этого правый щелчок по группе не доходил
    // никуда — меню просто не открывалось.
    callback open-row-menu(length, length, string, string, bool, string, bool);
    open-row-menu(ax, ay, pid, name, is-group, pids, throttled) => {
        // Координаты приходят в системе окна: у PopupWindow родитель — окно,
        // и без пересчёта он встаёт в угол.
        root.menu-x = ax - root.absolute-position.x;
        root.menu-y = ay - root.absolute-position.y;
        root.menu-pid = pid;
        root.menu-name = name;
        root.menu-group = is-group;
        root.menu-pids = pids;
        root.menu-throttled = throttled;
        root.confirming = "";
        menu.show();
    }

    callback refresh();
    // Пересортировать по столбцу. Rust перестраивает список и возвращает
    // его обратно: сортировать надо по числам, а в интерфейсе только текст.
    callback sort-by(int);
    // Применить действие к процессу: PID и код действия (0 экономичный
    // режим, 1 понизить приоритет памяти).
    callback apply-action(string, int);
    // Завершить процесс. Спрашиваем дважды: операция необратима.
    callback terminate-process(string);
    // Придержать или отпустить диск процесса.
    callback toggle-io-limit(string);
    // Переключить режим «по программам» / «по процессам».
    callback toggle-grouping();
    // Развернуть или свернуть группу по имени программы.
    callback toggle-group(string);
    // Включить или выключить игровой режим.
    callback toggle-game-mode();
    // Перестроить список после изменения фильтра.
    callback apply-filter();
    // Человек отказался от предложения. Дважды — и оно замолкает навсегда.
    callback reject-suggestion(string, int);
    // Переключить запуск вместе с Windows.
    callback toggle-autostart();
    // Переключить показ виджета при запуске.
    callback toggle-widget-on-start();
    // Остановить службу, которая возвращает завершённый процесс.
    callback stop-culprit-service();
    // Завершить все процессы группы. Спрашиваем дважды, как и для одного.
    callback terminate-group(string);
    // PID, для которого сейчас показан вопрос «точно завершить?».
    in-out property <string> confirming: "";

    callback minimize-window();
    callback close-window();
    // Начать перетаскивание окна за шапку.
    callback drag-window();
    // Начать растягивание окна за край. Номер края: 0 левый, 1 правый,
    // 2 верх, 3 верх-лево, 4 верх-право, 5 низ, 6 низ-лево, 7 низ-право.
    callback resize-window(int);

    // Меню действий по правой кнопке. Лежит в корне окна: из глубины
    // разметки — из `if` раздела и `for` по строкам — до него было бы
    // не достучаться, это разные области видимости.
    menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 260px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: #1e2a24;
            border-radius: 8px;
            border-width: 1px;
            border-color: #2f4038;

            VerticalLayout {
                padding: 6px;
                spacing: 1px;

                Text {
                    text: root.menu-name;
                    font-size: 12px;
                    color: #9fb3a8;
                    horizontal-alignment: center;
                    height: 26px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle { height: 1px; background: #2f4038; }

                MenuRow {
                    label: @tr("Экономичный режим");
                    hint: @tr("процессор");
                    chosen => { root.apply-action(root.menu-pid, 0); }
                }
                MenuRow {
                    label: @tr("Понизить приоритет памяти");
                    hint: @tr("память");
                    chosen => { root.apply-action(root.menu-pid, 1); }
                }
                MenuRow {
                    label: root.menu-throttled ? @tr("Отпустить диск") : @tr("Придержать диск");
                    hint: @tr("диск");
                    chosen => { root.toggle-io-limit(root.menu-pid); }
                }
                Rectangle { height: 1px; background: #2f4038; }
                MenuRow {
                    label: root.menu-group ? @tr("Завершить все процессы") : @tr("Завершить процесс");
                    hint: @tr("необратимо");
                    danger: true;
                    chosen => {
                        if (root.menu-group) {
                            root.terminate-group(root.menu-pids);
                        } else {
                            root.terminate-process(root.menu-pid);
                        }
                    }
                }
            }
        }
    }

    // Всё содержимое лежит внутри, а полосы захвата — поверх него по краям.
    Rectangle {

    VerticalLayout {

    // --- Своя шапка окна ---
    Rectangle {
        height: 36px;
        background: #0e1512;

        // Тянем окно за шапку. Перетаскивание делает Windows по нашей
        // просьбе, поэтому мышь не «убегает» от окна при быстром движении.
        TouchArea {
            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    root.drag-window();
                }
            }
        }

        HorizontalLayout {
            padding-left: 12px; spacing: 4px;
            Text {
                text: @tr("Bamboo — наблюдатель за системой");
                font-size: 12px;
                color: #b6c6bd;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            CaptionButton {
                label: "—";
                pressed => { root.minimize-window(); }
            }
            CaptionButton {
                // Знак умножения, а не «✕»: последний есть не во всех
                // шрифтах и на живой машине отрисовался пустотой.
                label: "×";
                danger: true;
                pressed => { root.close-window(); }
            }
        }
    }

    HorizontalLayout {
        // Навигация
        Rectangle {
            width: 180px;
            background: #0e1512;

            VerticalLayout {
                padding: 12px;
                spacing: 4px;

                Text {
                    text: "Bamboo";
                    font-size: 18px;
                    color: #e8f0ec;
                    horizontal-alignment: left;
                }
                Rectangle { height: 12px; }

                NavButton {
                    label: @tr("Обзор");
                    active: root.section == 0;
                    chosen => { root.section = 0; }
                }
                NavButton {
                    label: @tr("Процессы");
                    active: root.section == 1;
                    chosen => { root.section = 1; }
                }
                NavButton {
                    label: @tr("Диск");
                    active: root.section == 2;
                    chosen => { root.section = 2; root.refresh(); }
                }
                NavButton {
                    label: @tr("Питание");
                    active: root.section == 3;
                    chosen => { root.section = 3; root.refresh(); }
                }
                NavButton {
                    label: @tr("Загрузка");
                    active: root.section == 9;
                    chosen => { root.section = 9; root.refresh(); }
                }
                NavButton {
                    label: @tr("Автозапуск");
                    active: root.section == 10;
                    chosen => { root.section = 10; root.refresh(); }
                }
                NavButton {
                    label: @tr("Отчёты");
                    active: root.section == 11;
                    chosen => { root.section = 11; root.refresh(); }
                }
                NavButton {
                    label: @tr("Оптимизация");
                    active: root.section == 6;
                    chosen => { root.section = 6; root.refresh(); }
                }
                NavButton {
                    label: @tr("Журнал");
                    active: root.section == 4;
                    chosen => { root.section = 4; root.refresh(); }
                }
                NavButton {
                    label: @tr("Анализ");
                    active: root.section == 8;
                    chosen => { root.section = 8; root.refresh(); }
                }
                NavButton {
                    label: @tr("Браузер");
                    active: root.section == 7;
                    chosen => { root.section = 7; root.refresh(); }
                }
                NavButton {
                    label: @tr("Настройки");
                    active: root.section == 5;
                    chosen => { root.section = 5; }
                }

                Rectangle { vertical-stretch: 1; }

                Text {
                    text: root.learning;
                    font-size: 10px;
                    color: #62736a;
                    wrap: word-wrap;
                }
            }
        }

        // Содержимое
        Rectangle {
            background: #141b18;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                // --- Обзор ---
                if root.update-version != "": Rectangle {
                    background: #1d2c38; border-radius: 8px;
                    height: updbox.preferred-height;
                    updbox := HorizontalLayout {
                        padding: 12px; spacing: 12px;
                        VerticalLayout {
                            spacing: 3px;
                            horizontal-stretch: 1;
                            Text {
                                text: @tr("Вышла версия ") + root.update-version;
                                font-size: 13px; color: #8fc4f0;
                            }
                            Text {
                                text: root.update-notes;
                                font-size: 11px; color: #9fb3c4; wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            RowButton {
                                label: root.update-busy ? @tr("Качаю…") : @tr("Обновить");
                                width: 120px;
                                pressed => {
                                    if (!root.update-busy) { root.install-update(); }
                                }
                            }
                        }
                    }
                }

                if root.section == 0: VerticalLayout {
                    spacing: 10px;
                    Text { text: @tr("Обзор"); font-size: 20px; color: #e8f0ec; }

                    HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            background: #1e2a24; border-radius: 8px; height: 78px;
                            VerticalLayout {
                                padding: 12px;
                                Text { text: @tr("Процессор"); font-size: 11px; color: #7d8f86; }
                                Text { text: root.cpu-summary; font-size: 22px; color: #e8f0ec; }
                            }
                        }
                        Rectangle {
                            background: #1e2a24; border-radius: 8px; height: 78px;
                            VerticalLayout {
                                padding: 12px;
                                Text { text: @tr("Память"); font-size: 11px; color: #7d8f86; }
                                Text { text: root.memory-summary; font-size: 22px; color: #e8f0ec; }
                            }
                        }
                        Rectangle {
                            background: #1e2a24; border-radius: 8px; height: 78px;
                            VerticalLayout {
                                padding: 12px;
                                Text { text: @tr("Процессов"); font-size: 11px; color: #7d8f86; }
                                Text { text: root.process-summary; font-size: 22px; color: #e8f0ec; }
                            }
                        }
                    }

                    // Подвисания. Смотреть надо в момент подвисания, а он
                    // короткий: пока человек откроет окно, всё уже прошло.
                    // Поэтому показываем то, что было поймано раньше.
                    if root.freeze != "": Rectangle {
                        background: #2e2320; border-radius: 8px;
                        height: freezebox.preferred-height;
                        freezebox := HorizontalLayout {
                            padding: 12px; spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                horizontal-stretch: 1;
                                Text {
                                    text: @tr("Система подвисала");
                                    font-size: 12px; color: #e0a44a;
                                }
                                Text {
                                    text: root.freeze;
                                    font-size: 12px; color: #d8c4a8; wrap: word-wrap;
                                }
                            }
                            // Переход к виновникам. Прочитать имена мало:
                            // человек хочет с ними что-то сделать, а искать
                            // их в списке из трёхсот строк руками — работа.
                            if root.freeze-culprits != "": VerticalLayout {
                                alignment: center;
                                RowButton {
                                    label: @tr("Показать их");
                                    width: 120px;
                                    pressed => {
                                        root.filter = root.freeze-culprits;
                                        root.apply-filter();
                                        root.section = 1;
                                    }
                                }
                            }
                        }
                    }

                    // --- Игровой режим ---
                    Rectangle {
                        background: root.game-mode ? #23372c : #1e2a24;
                        border-radius: 8px;
                        height: game.preferred-height;
                        game := HorizontalLayout {
                            padding: 12px; spacing: 12px;
                            VerticalLayout {
                                spacing: 3px;
                                horizontal-stretch: 1;
                                Text {
                                    text: root.game-mode
                                        ? @tr("Игровой режим включён")
                                        : @tr("Игровой режим");
                                    font-size: 13px; color: #e8f0ec;
                                }
                                Text {
                                    text: root.game-mode
                                        ? @tr("Игра получает процессор и память в первую очередь. ")
                                          + @tr("Выключите — всё вернётся как было.")
                                        : @tr("Отдаёт процессор и память той программе, что сейчас ")
                                          + @tr("на экране. Фоновые уводит в энергосберегающий режим. ")
                                          + @tr("Discord, Steam и OBS не трогает.");
                                    font-size: 11px; color: #7d8f86; wrap: word-wrap;
                                }
                            }
                            Rectangle {
                                width: 110px;
                                VerticalLayout {
                                    alignment: center;
                                    RowButton {
                                        label: root.game-mode ? @tr("Выключить") : @tr("Включить");
                                        width: 110px;
                                        pressed => { root.toggle-game-mode(); }
                                    }
                                }
                            }
                        }
                    }

                    // --- Накопители ---
                    Text { text: @tr("Накопители"); font-size: 14px; color: #e8f0ec; }
                    if root.disk-pressure != "": Rectangle {
                        background: #2a211c; border-radius: 8px;
                        height: pressure.preferred-height;
                        pressure := VerticalLayout {
                            padding: 10px;
                            Text {
                                text: root.disk-pressure;
                                font-size: 12px; color: #e0a44a; wrap: word-wrap;
                            }
                        }
                    }
                    // Ядро само по себе виновником не бывает: объясняем,
                    // по чьему поручению оно работает с диском.
                    if root.system-io != "": Rectangle {
                        background: #1c2530; border-radius: 8px;
                        height: sysio.preferred-height;
                        sysio := VerticalLayout {
                            padding: 10px;
                            Text {
                                text: root.system-io;
                                font-size: 12px; color: #8fb4d8; wrap: word-wrap;
                            }
                        }
                    }
                    for disk in root.disk-load: Rectangle {
                        background: #1e2a24; border-radius: 8px;
                        VerticalLayout {
                            padding: 10px; spacing: 5px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: disk.name; font-size: 12px; color: #e8f0ec;
                                    vertical-alignment: center; horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Text {
                                    text: disk.busy;
                                    font-size: 12px;
                                    color: disk.saturated ? #e0724a : #b6c6bd;
                                    vertical-alignment: center;
                                }
                            }
                            // Полоска занятости: та же цифра, но видно сразу.
                            Rectangle {
                                height: 6px; background: #141b18; border-radius: 3px;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * disk.fill;
                                    height: parent.height;
                                    background: disk.saturated ? #c25a3a : #3f8f66;
                                    border-radius: 3px;
                                }
                            }
                            Text {
                                text: disk.speed + @tr("   в очереди: ") + disk.queue;
                                font-size: 11px; color: #7d8f86;
                            }
                        }
                    }

                    // --- Разделы ---
                    Text { text: @tr("Свободное место"); font-size: 14px; color: #e8f0ec; }
                    for volume in root.volumes: Rectangle {
                        background: #1e2a24; border-radius: 8px;
                        VerticalLayout {
                            padding: 10px; spacing: 5px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: volume.title; font-size: 12px; color: #e8f0ec;
                                    vertical-alignment: center; horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Text {
                                    text: volume.space; font-size: 12px;
                                    color: volume.cramped ? #e0724a : #b6c6bd;
                                    vertical-alignment: center;
                                }
                            }
                            Rectangle {
                                height: 6px; background: #141b18; border-radius: 3px;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * volume.fill;
                                    height: parent.height;
                                    background: volume.cramped ? #c25a3a : #3f8f66;
                                    border-radius: 3px;
                                }
                            }
                            if volume.cramped: Text {
                                text: @tr("Свободного места меньше десятой части. У SSD от этого ")
                                    + @tr("падает скорость записи: контроллеру негде раскладывать данные.");
                                font-size: 11px; color: #e0a44a; wrap: word-wrap;
                            }
                        }
                    }

                    // --- Подкачка ---
                    Text { text: @tr("Файл подкачки"); font-size: 14px; color: #e8f0ec; }
                    if root.pagefiles.length == 0: Text {
                        text: @tr("Подкачка отключена — Windows держит всё в оперативной памяти.");
                        font-size: 11px; color: #7d8f86; wrap: word-wrap;
                    }
                    for file in root.pagefiles: Rectangle {
                        background: #1e2a24; border-radius: 8px;
                        VerticalLayout {
                            padding: 10px; spacing: 5px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: file.where; font-size: 12px; color: #e8f0ec;
                                    vertical-alignment: center; horizontal-stretch: 1;
                                }
                                Text {
                                    text: file.used; font-size: 12px; color: #b6c6bd;
                                    vertical-alignment: center;
                                }
                            }
                            Rectangle {
                                height: 6px; background: #141b18; border-radius: 3px;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * file.fill;
                                    height: parent.height;
                                    background: #4a86c9;
                                    border-radius: 3px;
                                }
                            }
                            Text {
                                text: file.peak;
                                font-size: 11px; color: #7d8f86;
                            }
                        }
                    }

                    Text {
                        text: @tr("Bamboo наблюдает за системой и объясняет причины деградации. ")
                            + @tr("Действия применяются только по вашему решению и всегда обратимы.");
                        font-size: 12px; color: #7d8f86; wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; }
                }

                // --- Процессы ---
                if root.section == 1: VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.grouped ? @tr("Программы") : @tr("Процессы");
                            font-size: 20px; color: #e8f0ec;
                            vertical-alignment: center; horizontal-stretch: 1;
                        }
                        // Поиск по имени: на трёхстах процессах глазами
                        // нужный не найти.
                        Rectangle {
                            width: 200px;
                            height: 26px;
                            background: #1a231f;
                            border-radius: 5px;
                            border-width: 1px;
                            border-color: search.has-focus ? #2f6f4f : #24312b;

                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 4px;
                                Text {
                                    text: "🔍";
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                search := TextInput {
                                    text <=> root.filter;
                                    font-size: 12px;
                                    color: #e8f0ec;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    single-line: true;
                                    accepted => { root.apply-filter(); }
                                    edited => { root.apply-filter(); }
                                }
                                if root.filter == "": Text {
                                    text: @tr("поиск");
                                    font-size: 12px;
                                    color: #62736a;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        RowButton {
                            label: root.grouped ? @tr("по процессам") : @tr("по программам");
                            width: 118px;
                            pressed => { root.toggle-grouping(); }
                        }
                    }
                    Text {
                        text: @tr("Правая кнопка по процессу — меню действий. Щелчок по имени ")
                            + @tr("программы разворачивает её процессы. Столбец «Рост памяти» ")
                            + @tr("показывает то, чего нет в диспетчере задач: не сколько памяти ")
                            + @tr("занято сейчас, а растёт ли она и как быстро. Показаны первые ")
                            + @tr("80 строк — сортировка идёт по всем процессам.");
                        font-size: 11px; color: #62736a; wrap: word-wrap;
                    }
                    HorizontalLayout {
                        padding-left: 10px; padding-right: 6px; spacing: 6px;
                        ColumnHeader {
                            label: @tr("Процесс"); horizontal-stretch: 1; min-width: 220px;
                            active: root.sort-column == 0; descending: root.sort-descending;
                            chosen => { root.sort-by(0); }
                        }
                        ColumnHeader {
                            label: "PID"; width: 60px;
                            active: root.sort-column == 1; descending: root.sort-descending;
                            chosen => { root.sort-by(1); }
                        }
                        ColumnHeader {
                            label: "CPU"; width: 58px; align-right: true;
                            active: root.sort-column == 2; descending: root.sort-descending;
                            chosen => { root.sort-by(2); }
                        }
                        ColumnHeader {
                            label: @tr("Память"); width: 86px; align-right: true;
                            active: root.sort-column == 3; descending: root.sort-descending;
                            chosen => { root.sort-by(3); }
                        }
                        ColumnHeader {
                            label: root.grouped ? @tr("Процессов") : @tr("Потоки"); width: 72px; align-right: true;
                            active: root.sort-column == 4; descending: root.sort-descending;
                            chosen => { root.sort-by(4); }
                        }
                        ColumnHeader {
                            label: @tr("Рост памяти"); width: 104px; align-right: true;
                            active: root.sort-column == 5; descending: root.sort-descending;
                            chosen => { root.sort-by(5); }
                        }
                        ColumnHeader {
                            label: @tr("Диск"); width: 88px; align-right: true;
                            active: root.sort-column == 7; descending: root.sort-descending;
                            chosen => { root.sort-by(7); }
                        }
                        Text {
                            text: @tr("Изменения"); width: 112px;
                            font-size: 11px; color: #7d8f86; vertical-alignment: center;
                        }
                        ColumnHeader {
                            label: @tr("Состояние"); width: 88px;
                            active: root.sort-column == 6; descending: root.sort-descending;
                            chosen => { root.sort-by(6); }
                        }
                        
                    }
                    Flickable {
                        VerticalLayout {
                            spacing: 2px;
                            for process[index] in root.processes: Rectangle {
                                height: 32px;
                                // Подсветку строки НЕ завязываем на её TouchArea.
                                // Стоит навести мышь на кнопку, как та перехватывает
                                // наведение, строка его теряет и гаснет прямо под
                                // курсором. Поэтому фон ровный, а читаемость даёт
                                // чередование строк.
                                background: process.is-member
                                    ? #16202a
                                    : (Math.mod(index, 2) == 0 ? #1b2521 : #18211d);
                                border-radius: 5px;

                                // Правая кнопка открывает меню действий. Кнопки
                                // в каждой строке занимали треть таблицы и всё
                                // равно не вмещались — меню и привычнее, и
                                // оставляет место данным.
                                row-touch := TouchArea {
                                    pointer-event(event) => {
                                        if (event.button == PointerEventButton.right
                                            && event.kind == PointerEventKind.down) {
                                            root.open-row-menu(
                                                row-touch.absolute-position.x + row-touch.mouse-x,
                                                row-touch.absolute-position.y + row-touch.mouse-y,
                                                process.pid, process.name, process.is-group,
                                                process.member-pids, process.throttled);
                                        }
                                    }
                                }

                                // Процесс внутри группы отмечаем полоской слева.
                                if process.is-member: Rectangle {
                                    x: 0; y: 5px;
                                    width: 3px;
                                    height: parent.height - 10px;
                                    background: #4a86c9;
                                    border-radius: 2px;
                                }

                                HorizontalLayout {
                                    padding-left: 10px; padding-right: 6px; spacing: 6px;

                                    // Имя. У группы оно же и кнопка разворота,
                                    // поэтому подсвечивается при наведении — видно,
                                    // что по нему можно щёлкнуть.
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        min-width: 220px;
                                        background: (process.is-group && name-touch.has-hover)
                                            ? #24332c : transparent;
                                        border-radius: 4px;

                                        name-touch := TouchArea {
                                            enabled: process.is-group;
                                            mouse-cursor: process.is-group
                                                ? MouseCursor.pointer
                                                : MouseCursor.default;
                                            clicked => { root.toggle-group(process.name); }
                                            // Имя группы лежит поверх строки и
                                            // перехватывает щелчки. Правый надо
                                            // обработать здесь же, иначе по группе
                                            // меню не открыть — а именно у группы
                                            // есть что предложить: завершить всю
                                            // разом.
                                            pointer-event(event) => {
                                                if (event.button == PointerEventButton.right
                                                    && event.kind == PointerEventKind.down) {
                                                    root.open-row-menu(
                                                        name-touch.absolute-position.x
                                                            + name-touch.mouse-x,
                                                        name-touch.absolute-position.y
                                                            + name-touch.mouse-y,
                                                        process.pid, process.name,
                                                        process.is-group,
                                                        process.member-pids,
                                                        process.throttled);
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            padding-left: 4px; spacing: 5px;
                                            // Стрелка отдельным элементом: у неё своя
                                            // ширина, и имена не разъезжаются.
                                            Text {
                                                text: process.is-group
                                                    ? (process.expanded ? "\u{25bc}" : "\u{25b6}")
                                                    : "";
                                                font-size: 10px;
                                                color: name-touch.has-hover ? #ffffff : #7d8f86;
                                                vertical-alignment: center;
                                                width: 10px;
                                            }
                                            Text {
                                                // Имя строки готовит Rust: у члена
                                                // группы это заголовок окна либо номер.
                                                text: process.name;
                                                color: process.is-member ? #9fb3c8 : #e8f0ec;
                                                font-size: 12px;
                                                font-weight: process.is-group ? 700 : 400;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                        }
                                    }

                                    Text {
                                        text: process.is-member ? "" : process.pid;
                                        color: #8a9b92; font-size: 12px;
                                        vertical-alignment: center; width: 60px;
                                    }
                                    // Числа по правому краю: разряды встают под
                                    // разрядами, и колонку можно читать сверху вниз.
                                    Text {
                                        text: process.cpu;
                                        color: #d5e2da; font-size: 12px;
                                        vertical-alignment: center;
                                        horizontal-alignment: right; width: 58px;
                                    }
                                    Text {
                                        text: process.memory;
                                        color: #d5e2da; font-size: 12px;
                                        vertical-alignment: center;
                                        horizontal-alignment: right; width: 86px;
                                    }
                                    Text {
                                        text: process.threads;
                                        color: #8a9b92; font-size: 12px;
                                        vertical-alignment: center;
                                        horizontal-alignment: right; width: 72px;
                                    }
                                    Text {
                                        text: process.growth;
                                        color: process.leak ? #e0a44a : #8a9b92;
                                        font-size: 11px; vertical-alignment: center;
                                        horizontal-alignment: right; width: 104px;
                                    }
                                    Text {
                                        text: process.disk;
                                        color: #7fb0d8;
                                        font-size: 11px; vertical-alignment: center;
                                        horizontal-alignment: right; width: 88px;
                                    }
                                    Text {
                                        text: process.applied;
                                        color: #6fb58a;
                                        font-size: 11px; vertical-alignment: center;
                                        width: 112px; overflow: elide;
                                    }
                                    Text {
                                        text: process.state;
                                        color: #e0724a;
                                        font-size: 11px; vertical-alignment: center; width: 88px;
                                    }

                                }
                            }
                        }
                    }

                    // Сообщение о последнем действии. Если процесс вернулся
                    // из-за службы, рядом появляется кнопка остановки: без
                    // неё совет «разберитесь со службой» остаётся советом.
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.action-note;
                            font-size: 11px; color: #9fb3a8; wrap: word-wrap;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        if root.culprit-service != "": RowButton {
                            label: @tr("Остановить службу");
                            danger: true;
                            width: 140px;
                            pressed => { root.stop-culprit-service(); }
                        }
                    }
                }

                // --- Диск ---
                if root.section == 2: VerticalLayout {
                    spacing: 8px;
                    Text { text: @tr("Диск"); font-size: 20px; color: #e8f0ec; }

                    // Кто занимает диск — тот самый вопрос, ради которого
                    // раздел и открывают. Здоровье накопителя на него
                    // не отвечает, поэтому список идёт первым.
                    Text { text: @tr("Кто занимает диск"); font-size: 14px; color: #b6c6bd; }
                    for user in root.disk-users: Rectangle {
                        background: #1e2a24; border-radius: 6px;
                        height: 40px;
                        VerticalLayout {
                            padding: 8px; spacing: 4px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: user.name; font-size: 12px; color: #e8f0ec;
                                    horizontal-stretch: 1; overflow: elide;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: user.rate; font-size: 12px; color: #7fb0d8;
                                    vertical-alignment: center;
                                }
                            }
                            Rectangle {
                                height: 3px; background: #16201b; border-radius: 2px;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * user.share;
                                    height: parent.height;
                                    background: #4a86c9; border-radius: 2px;
                                }
                            }
                        }
                    }
                    if root.disk-users-note != "": Text {
                        text: root.disk-users-note;
                        font-size: 11px; color: #7d8f86; wrap: word-wrap;
                    }

                    Text {
                        text: @tr("Здоровье накопителя"); font-size: 14px; color: #b6c6bd;
                    }
                    for drive in root.drives: Rectangle {
                        background: #1e2a24; border-radius: 8px;
                        VerticalLayout {
                            padding: 12px; spacing: 4px;
                            Text { text: drive.title; font-size: 14px; color: #e8f0ec; }
                            Text { text: drive.facts; font-size: 11px; color: #7d8f86; }
                            Text { text: drive.verdict; font-size: 12px; color: #b6c6bd; wrap: word-wrap; }
                        }
                    }
                    Text { text: root.disk-note; font-size: 11px; color: #62736a; wrap: word-wrap; }
                    Rectangle { vertical-stretch: 1; }
                }

                // --- Анализ программы ---
                if root.section == 8: VerticalLayout {
                    spacing: 10px;
                    Text { text: @tr("Анализ программы"); font-size: 20px; color: #e8f0ec; }
                    Text {
                        text: @tr("Выберите программу, запишите сеанс и посмотрите, что ")
                            + @tr("упиралось в потолок. Мгновенные числа тут бесполезны: ")
                            + @tr("просадка длится секунду, и к моменту, когда вы ")
                            + @tr("переключитесь, всё уже прошло.");
                        font-size: 11px; color: #62736a; wrap: word-wrap;
                    }

                    Rectangle {
                        background: root.recording ? #23372c : #1e2a24;
                        border-radius: 8px;
                        height: recbox.preferred-height;
                        recbox := HorizontalLayout {
                            padding: 12px; spacing: 10px;
                            // Выбор из списка, а не поле для ввода: человек
                            // знает игру по названию, а не по тому, что её
                            // файл зовётся BitCraft.exe. Выяснять это за него
                            // должна программа.
                            Rectangle {
                                background: #141b18; border-radius: 6px;
                                horizontal-stretch: 1;
                                height: 32px;
                                border-width: 1px;
                                border-color: pick-touch.has-hover ? #3a4a42 : #232f29;

                                pick-touch := TouchArea {
                                    enabled: !root.recording;
                                    mouse-cursor: root.recording
                                        ? MouseCursor.default
                                        : MouseCursor.pointer;
                                    clicked => { root.targets-open = !root.targets-open; }
                                }
                                HorizontalLayout {
                                    padding-left: 10px; padding-right: 10px; spacing: 6px;
                                    Text {
                                        text: root.record-app == ""
                                            ? @tr("выберите игру или программу")
                                            : root.record-app;
                                        color: root.record-app == "" ? #4d5b53 : #e8f0ec;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: root.targets-open ? "\u{25b2}" : "\u{25bc}";
                                        color: #7d8f86; font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            RowButton {
                                label: root.recording ? @tr("Остановить") : @tr("Записать");
                                width: 130px;
                                pressed => { root.toggle-recording(root.record-app); }
                            }
                        }
                    }

                    // Список — обычным блоком под полем, а не PopupWindow:
                    // всплывающее окно закрывается от любого щелчка, и
                    // прокрутить в нём длинный список нельзя.
                    if root.targets-open: Rectangle {
                        background: #17201c;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #2a3a32;
                        height: 240px;

                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;

                            if root.targets-note != "": Text {
                                text: root.targets-note;
                                font-size: 11px; color: #62736a; wrap: word-wrap;
                            }
                            Flickable {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 2px;
                                    for target[index] in root.targets: Rectangle {
                                        height: 30px;
                                        background: target-touch.has-hover
                                            ? #24332c
                                            : (Math.mod(index, 2) == 0 ? #1b2521 : #18211d);
                                        border-radius: 5px;

                                        target-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.record-app = target.exe;
                                                root.targets-open = false;
                                            }
                                        }
                                        HorizontalLayout {
                                            padding-left: 10px; padding-right: 10px; spacing: 8px;
                                            Text {
                                                text: target.label;
                                                font-size: 12px; color: #e8f0ec;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: target.exe;
                                                font-size: 11px; color: #7d8f86;
                                                vertical-alignment: center;
                                                width: 170px;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: target.source;
                                                font-size: 11px; color: #62736a;
                                                vertical-alignment: center;
                                                width: 130px;
                                                horizontal-alignment: right;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Text {
                        text: root.record-status;
                        font-size: 12px; color: #9fb3a8; wrap: word-wrap;
                    }

                    if root.record-cpu.length > 0: Flickable {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 10px;
                            Chart {
                                title: @tr("Процессор");
                                scale: root.record-scale-cpu;
                                points: root.record-cpu;
                                tint: #6fb58a;
                            }
                            Chart {
                                title: @tr("Память");
                                scale: root.record-scale-memory;
                                points: root.record-memory;
                                tint: #7fb0d8;
                            }
                            if root.record-has-gpu: Chart {
                                title: @tr("Видеокарта");
                                scale: "0-100%";
                                points: root.record-gpu;
                                tint: #c08fd8;
                            }
                            Chart {
                                title: @tr("Диск");
                                scale: root.record-scale-disk;
                                points: root.record-disk;
                                tint: #e0a44a;
                            }
                        }
                    }
                    if root.record-cpu.length == 0: Rectangle { vertical-stretch: 1; }

                    if root.record-verdict != "": Rectangle {
                        background: #1d2c38; border-radius: 8px;
                        height: verdictbox.preferred-height;
                        verdictbox := VerticalLayout {
                            padding: 12px;
                            Text {
                                text: root.record-verdict;
                                font-size: 12px; color: #b6c6bd; wrap: word-wrap;
                            }
                        }
                    }
                }

                // --- Загрузка ---
                if root.section == 9: VerticalLayout {
                    spacing: 8px;
                    Text { text: @tr("Загрузка системы"); font-size: 20px; color: #e8f0ec; }
                    Text {
                        text: root.boot-note;
                        font-size: 11px; color: #7d8f86; wrap: word-wrap;
                    }
                    Flickable {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 4px;
                            for boot[index] in root.boots: Rectangle {
                                background: boot.degraded ? #2e2320 : #1e2a24;
                                border-radius: 8px;
                                height: 54px;
                                VerticalLayout {
                                    padding: 10px; spacing: 3px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: boot.when;
                                            font-size: 12px; color: #e8f0ec;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: boot.total;
                                            font-size: 13px;
                                            color: boot.degraded ? #e0a44a : #6fb58a;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Text {
                                        text: boot.slower != ""
                                            ? boot.phases + " — " + boot.slower
                                            : boot.phases;
                                        font-size: 11px;
                                        color: boot.degraded ? #d8c4a8 : #7d8f86;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }

                // --- Автозапуск ---
                if root.section == 10: VerticalLayout {
                    spacing: 8px;
                    Text { text: @tr("Автозапуск"); font-size: 20px; color: #e8f0ec; }
                    Text {
                        text: root.startup-note;
                        font-size: 11px; color: #7d8f86; wrap: word-wrap;
                    }
                    Flickable {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 3px;
                            for item[index] in root.startup: Rectangle {
                                background: Math.mod(index, 2) == 0 ? #1b2521 : #18211d;
                                border-radius: 6px;
                                height: 46px;
                                HorizontalLayout {
                                    padding: 8px; spacing: 10px;
                                    VerticalLayout {
                                        spacing: 2px;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: item.name;
                                            font-size: 12px;
                                            color: item.enabled ? #e8f0ec : #62736a;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: item.command;
                                            font-size: 10px; color: #4d5b53;
                                            overflow: elide;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        RowButton {
                                            label: item.enabled ? @tr("Выключить") : @tr("Включить");
                                            width: 110px;
                                            pressed => {
                                                root.toggle-startup(item.name, !item.enabled);
                                                root.refresh();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Text {
                        text: root.action-note;
                        font-size: 11px; color: #9fb3a8; wrap: word-wrap;
                    }
                }

                // --- Отчёты ---
                if root.section == 11: VerticalLayout {
                    spacing: 10px;
                    Text { text: @tr("Недельный отчёт"); font-size: 20px; color: #e8f0ec; }

                    HorizontalLayout {
                        spacing: 8px;
                        for name[index] in [@tr("Текст"), "HTML", "JSON"]: RowButton {
                            label: name;
                            width: 100px;
                            pressed => {
                                root.report-format = index;
                                root.build-report();
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        RowButton {
                            label: @tr("Сохранить");
                            width: 120px;
                            pressed => { root.save-report(); }
                        }
                    }

                    Text {
                        text: root.report-note;
                        font-size: 11px; color: #7d8f86; wrap: word-wrap;
                    }

                    Rectangle {
                        background: #141b18;
                        border-radius: 8px;
                        vertical-stretch: 1;
                        Flickable {
                            x: 10px; y: 10px;
                            width: parent.width - 20px;
                            height: parent.height - 20px;
                            VerticalLayout {
                                Text {
                                    text: root.report-text != ""
                                        ? root.report-text
                                        : @tr("Нажмите «Текст», «HTML» или «JSON», чтобы собрать отчёт.");
                                    font-size: 11px;
                                    color: root.report-text != "" ? #b6c6bd : #4d5b53;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }

                // --- Браузер ---
                if root.section == 7: VerticalLayout {
                    spacing: 8px;
                    Text { text: @tr("Расширения браузера"); font-size: 20px; color: #e8f0ec; }
                    Text {
                        text: root.extensions-note;
                        font-size: 11px; color: #7d8f86; wrap: word-wrap;
                    }
                    Flickable {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 3px;
                            for extension[index] in root.extensions: Rectangle {
                                height: 30px;
                                background: Math.mod(index, 2) == 0 ? #1b2521 : #18211d;
                                border-radius: 5px;
                                HorizontalLayout {
                                    padding-left: 10px; padding-right: 10px; spacing: 8px;
                                    Text {
                                        text: extension.name;
                                        font-size: 12px; color: #e8f0ec;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1; overflow: elide;
                                    }
                                    Text {
                                        text: extension.browser;
                                        font-size: 11px; color: #7d8f86;
                                        vertical-alignment: center;
                                        width: 120px;
                                        horizontal-alignment: right;
                                    }
                                }
                            }
                        }
                    }
                }

                // --- Питание ---
                if root.section == 3: VerticalLayout {
                    spacing: 8px;
                    Text { text: @tr("Питание"); font-size: 20px; color: #e8f0ec; }
                    for wake in root.wakes: Rectangle {
                        height: 30px; background: #1a231f; border-radius: 5px;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px; spacing: 8px;
                            Text { text: wake.when; color: #7d8f86; font-size: 12px; vertical-alignment: center; width: 190px; }
                            Text { text: wake.source; color: #e8f0ec; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                        }
                    }
                    Text { text: root.power-note; font-size: 11px; color: #62736a; wrap: word-wrap; }
                    Rectangle { vertical-stretch: 1; }
                }

                // --- Журнал ---
                if root.section == 4: VerticalLayout {
                    spacing: 8px;
                    Text { text: @tr("Журнал действий"); font-size: 20px; color: #e8f0ec; }
                    for entry in root.journal: Rectangle {
                        height: 30px; background: #1a231f; border-radius: 5px;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px; spacing: 6px;
                            Text { text: entry.when; color: #7d8f86; font-size: 11px; vertical-alignment: center; width: 150px; }
                            Text { text: entry.action; color: #e8f0ec; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            Text { text: entry.target; color: #b6c6bd; font-size: 12px; vertical-alignment: center; width: 180px; overflow: elide; }
                            Text { text: entry.status; color: #7d8f86; font-size: 11px; vertical-alignment: center; width: 100px; }
                        }
                    }
                    Text { text: root.journal-note; font-size: 11px; color: #62736a; wrap: word-wrap; }
                    Rectangle { vertical-stretch: 1; }
                }

                // --- Оптимизация ---
                if root.section == 6: VerticalLayout {
                    spacing: 8px;
                    Text { text: @tr("Что можно улучшить"); font-size: 20px; color: #e8f0ec; }
                    Text {
                        text: @tr("Bamboo предлагает только то, что видит своими глазами, ")
                            + @tr("и объясняет причину каждого предложения. Всё применяется ")
                            + @tr("по вашему решению и записывается в журнал — откатить можно ")
                            + @tr("в любой момент.");
                        font-size: 11px; color: #62736a; wrap: word-wrap;
                    }

                    // Самостоятельная оптимизация. Право вмешиваться даётся
                    // только тому, что умеет вернуть как было.
                    Rectangle {
                        background: root.autopilot ? #23372c : #1e2a24;
                        border-radius: 8px;
                        height: pilot.preferred-height;
                        pilot := HorizontalLayout {
                            padding: 12px; spacing: 12px;
                            VerticalLayout {
                                spacing: 3px;
                                horizontal-stretch: 1;
                                Text {
                                    text: @tr("Оптимизировать самостоятельно");
                                    font-size: 13px; color: #e8f0ec;
                                }
                                Text {
                                    text: root.autopilot-status;
                                    font-size: 11px; color: #7d8f86; wrap: word-wrap;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                RowButton {
                                    label: root.autopilot ? @tr("Выключить") : @tr("Включить");
                                    width: 110px;
                                    pressed => { root.toggle-autopilot(); }
                                }
                            }
                        }
                    }

                    if root.suggestions-note != "": Rectangle {
                        background: #1e2a24; border-radius: 8px;
                        height: note.preferred-height;
                        note := VerticalLayout {
                            padding: 12px;
                            Text {
                                text: root.suggestions-note;
                                font-size: 12px; color: #7d8f86; wrap: word-wrap;
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }

                    Flickable {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 6px;
                            for item in root.suggestions: Rectangle {
                                background: #1e2a24; border-radius: 8px;
                                height: card.preferred-height;
                                card := HorizontalLayout {
                                    padding: 12px; spacing: 10px;
                                    VerticalLayout {
                                        spacing: 3px;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: item.title;
                                            font-size: 13px; color: #e8f0ec; wrap: word-wrap;
                                        }
                                        Text {
                                            text: item.reason;
                                            font-size: 11px; color: #e0a44a; wrap: word-wrap;
                                        }
                                        Text {
                                            text: item.effect;
                                            font-size: 11px; color: #7d8f86; wrap: word-wrap;
                                        }
                                    }
                                    if item.button != "": Rectangle {
                                        width: 100px;
                                        VerticalLayout {
                                            alignment: center;
                                            RowButton {
                                                label: item.button;
                                                width: 100px;
                                                pressed => {
                                                    if (item.action == 2) {
                                                        root.toggle-io-limit(item.pid);
                                                    } else {
                                                        root.apply-action(item.pid, item.action);
                                                    }
                                                    root.refresh();
                                                }
                                            }
                                        }
                                    }
                                    // Отказ — такое же решение, как согласие,
                                    // и у него должна быть своя кнопка.
                                    // Без неё человеку остаётся только молча
                                    // не нажимать, а Bamboo будет предлагать
                                    // одно и то же бесконечно.
                                    if item.button != "": Rectangle {
                                        width: 110px;
                                        VerticalLayout {
                                            alignment: center;
                                            RowButton {
                                                label: @tr("Не трогать");
                                                width: 110px;
                                                pressed => {
                                                    root.reject-suggestion(
                                                        item.pid, item.action);
                                                    root.refresh();
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Text {
                        text: root.action-note;
                        font-size: 11px; color: #9fb3a8; wrap: word-wrap;
                    }
                }

                // --- Настройки ---
                if root.section == 5: VerticalLayout {
                    spacing: 10px;
                    Text { text: @tr("Настройки"); font-size: 20px; color: #e8f0ec; }

                    // Собственный расход. Утилита, которая считает чужие
                    // ресурсы и молчит про свои, занимается двойной моралью.
                    if root.budget.length > 0: Rectangle {
                        background: #1e2a24; border-radius: 8px;
                        height: budgetbox.preferred-height;
                        budgetbox := VerticalLayout {
                            padding: 12px; spacing: 6px;
                            Text {
                                text: @tr("Собственный бюджет");
                                font-size: 13px; color: #e8f0ec;
                            }
                            for row in root.budget: HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: row.metric;
                                    font-size: 11px; color: #9fb3a8;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: row.measured;
                                    font-size: 11px;
                                    color: row.state == 2 ? #e0724a
                                        : (row.state == 1 ? #6fb58a : #62736a);
                                    width: 150px;
                                    horizontal-alignment: right;
                                }
                                Text {
                                    text: "\u{2264} " + row.limit;
                                    font-size: 11px; color: #4d5b53;
                                    width: 90px;
                                    horizontal-alignment: right;
                                }
                            }
                            Text {
                                text: root.budget-verdict;
                                font-size: 11px; color: #7d8f86; wrap: word-wrap;
                            }
                        }
                    }

                    // Язык интерфейса.
                    Rectangle {
                        background: #1e2a24; border-radius: 8px;
                        height: langbox.preferred-height;
                        langbox := HorizontalLayout {
                            padding: 12px; spacing: 12px;
                            VerticalLayout {
                                spacing: 3px;
                                horizontal-stretch: 1;
                                Text {
                                    text: @tr("Язык интерфейса");
                                    font-size: 13px; color: #e8f0ec;
                                }
                                Text {
                                    text: root.language == "ru"
                                        ? @tr("Сейчас русский. Смена языка вступает в силу после перезапуска.")
                                        : @tr("Currently English. A language change takes effect after a restart.");
                                    font-size: 11px; color: #7d8f86; wrap: word-wrap;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                RowButton {
                                    label: root.language == "ru" ? "English" : "Русский";
                                    width: 110px;
                                    pressed => { root.toggle-language(); }
                                }
                            }
                        }
                    }

                    // Свой расход. Bamboo считает чужую запись на диск
                    // и обязан показывать собственную: утилита, которая
                    // ругает других за износ накопителя и молчит про себя,
                    // занимается двойной моралью.
                    if root.history-note != "": Rectangle {
                        background: #1e2a24; border-radius: 8px;
                        height: histbox.preferred-height;
                        histbox := VerticalLayout {
                            padding: 12px; spacing: 3px;
                            Text {
                                text: @tr("История наблюдений");
                                font-size: 13px; color: #e8f0ec;
                            }
                            Text {
                                text: root.history-note;
                                font-size: 11px; color: #7d8f86; wrap: word-wrap;
                            }
                        }
                    }

                    // Версия и обновление. Проверка идёт сама раз в сутки,
                    // но кнопка нужна: человек, услышавший про новую версию,
                    // не должен ждать до завтра.
                    Rectangle {
                        background: #1e2a24; border-radius: 8px;
                        height: verbox.preferred-height;
                        verbox := HorizontalLayout {
                            padding: 12px; spacing: 12px;
                            VerticalLayout {
                                spacing: 3px;
                                horizontal-stretch: 1;
                                Text {
                                    text: @tr("Версия ") + root.app-version;
                                    font-size: 13px; color: #e8f0ec;
                                }
                                Text {
                                    text: root.update-status;
                                    font-size: 11px; color: #7d8f86; wrap: word-wrap;
                                }
                            }
                            Rectangle {
                                width: 130px;
                                VerticalLayout {
                                    alignment: center;
                                    RowButton {
                                        label: root.update-busy
                                            ? @tr("Проверяю…")
                                            : (root.update-version != ""
                                                ? @tr("Обновить")
                                                : @tr("Проверить"));
                                        width: 130px;
                                        pressed => {
                                            if (root.update-busy) { return; }
                                            if (root.update-version != "") {
                                                root.install-update();
                                            } else {
                                                root.check-update();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        background: #1e2a24; border-radius: 8px;
                        height: startup.preferred-height;
                        startup := HorizontalLayout {
                            padding: 12px; spacing: 12px;
                            VerticalLayout {
                                spacing: 3px;
                                horizontal-stretch: 1;
                                Text {
                                    text: @tr("Запускать вместе с Windows");
                                    font-size: 13px; color: #e8f0ec;
                                }
                                Text {
                                    text: root.autostart
                                        ? @tr("Bamboo запустится сам и продолжит наблюдение.")
                                        : @tr("Сейчас выключено. Наблюдение идёт только пока ")
                                          + @tr("программа запущена, а выводы о росте памяти ")
                                          + @tr("требуют нескольких часов подряд.");
                                    font-size: 11px; color: #7d8f86; wrap: word-wrap;
                                }
                            }
                            Rectangle {
                                width: 110px;
                                VerticalLayout {
                                    alignment: center;
                                    RowButton {
                                        label: root.autostart ? @tr("Выключить") : @tr("Включить");
                                        width: 110px;
                                        pressed => { root.toggle-autostart(); }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        background: #1e2a24; border-radius: 8px;
                        height: widgetstart.preferred-height;
                        widgetstart := HorizontalLayout {
                            padding: 12px; spacing: 12px;
                            VerticalLayout {
                                spacing: 3px;
                                horizontal-stretch: 1;
                                Text {
                                    text: @tr("Показывать виджет при запуске");
                                    font-size: 13px; color: #e8f0ec;
                                }
                                Text {
                                    text: root.show-widget-on-start
                                        ? @tr("Виджет появится сразу вместе с Bamboo.")
                                        : @tr("Bamboo запускается в трее. Виджет открывается ")
                                          + @tr("щелчком по значку — наблюдение идёт в любом случае.");
                                    font-size: 11px; color: #7d8f86; wrap: word-wrap;
                                }
                            }
                            Rectangle {
                                width: 110px;
                                VerticalLayout {
                                    alignment: center;
                                    RowButton {
                                        label: root.show-widget-on-start ? @tr("Выключить") : @tr("Включить");
                                        width: 110px;
                                        pressed => { root.toggle-widget-on-start(); }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        background: #1e2a24; border-radius: 8px;
                        height: watch.preferred-height;
                        watch := VerticalLayout {
                            padding: 12px; spacing: 3px;
                            Text {
                                text: @tr("Наблюдение");
                                font-size: 13px; color: #e8f0ec;
                            }
                            Text {
                                text: root.watch-status;
                                font-size: 11px; color: #7d8f86; wrap: word-wrap;
                            }
                        }
                    }

                    Rectangle {
                        background: #1e2a24; border-radius: 8px;
                        height: about.preferred-height;
                        about := VerticalLayout {
                            padding: 12px; spacing: 3px;
                            Text {
                                text: @tr("О программе");
                                font-size: 13px; color: #e8f0ec;
                            }
                            Text {
                                text: @tr("Bamboo наблюдает за системой и объясняет, что в ней ")
                                    + @tr("происходит. Все действия записываются в журнал и ")
                                    + @tr("обратимы. Того, что нельзя измерить, Bamboo не обещает: ")
                                    + @tr("здесь нет «очистки памяти», «ускорения интернета» ")
                                    + @tr("и прочего, чему нет доказательств.");
                                font-size: 11px; color: #7d8f86; wrap: word-wrap;
                            }
                        }
                    }

                    Text {
                        text: root.action-note;
                        font-size: 11px; color: #9fb3a8; wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
    }

    }

    // Полосы захвата по периметру. Ширина в четыре пиксела — как у обычной
    // рамки Windows: достаточно, чтобы попасть мышью, и не настолько много,
    // чтобы мешать нажимать на содержимое у края.
    ResizeGrip {
        edge: 0; shape: MouseCursor.ew-resize;
        x: 0; y: 4px; width: 4px; height: parent.height - 8px;
        grabbed(edge) => { root.resize-window(edge); }
    }
    ResizeGrip {
        edge: 1; shape: MouseCursor.ew-resize;
        x: parent.width - 4px; y: 4px; width: 4px; height: parent.height - 8px;
        grabbed(edge) => { root.resize-window(edge); }
    }
    ResizeGrip {
        edge: 2; shape: MouseCursor.ns-resize;
        x: 4px; y: 0; width: parent.width - 8px; height: 4px;
        grabbed(edge) => { root.resize-window(edge); }
    }
    ResizeGrip {
        edge: 5; shape: MouseCursor.ns-resize;
        x: 4px; y: parent.height - 4px; width: parent.width - 8px; height: 4px;
        grabbed(edge) => { root.resize-window(edge); }
    }
    ResizeGrip {
        edge: 3; shape: MouseCursor.nwse-resize;
        x: 0; y: 0; width: 8px; height: 8px;
        grabbed(edge) => { root.resize-window(edge); }
    }
    ResizeGrip {
        edge: 4; shape: MouseCursor.nesw-resize;
        x: parent.width - 8px; y: 0; width: 8px; height: 8px;
        grabbed(edge) => { root.resize-window(edge); }
    }
    ResizeGrip {
        edge: 6; shape: MouseCursor.nesw-resize;
        x: 0; y: parent.height - 8px; width: 8px; height: 8px;
        grabbed(edge) => { root.resize-window(edge); }
    }
    ResizeGrip {
        edge: 7; shape: MouseCursor.nwse-resize;
        x: parent.width - 8px; y: parent.height - 8px; width: 8px; height: 8px;
        grabbed(edge) => { root.resize-window(edge); }
    }

    }
}
