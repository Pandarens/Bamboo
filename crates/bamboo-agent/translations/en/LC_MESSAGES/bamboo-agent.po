# Английский перевод интерфейса Bamboo.
#
# Переводы вкомпилируются в исполняемый файл на сборке, а не читаются
# gettext во время работы: фича slint/gettext на Windows не делает ничего,
# её код целиком под cfg(unix). Встроенные переводы — другой механизм,
# и он работает везде. Проверено: строки видны в собранном файле.
#
# Контекст — имя компонента Slint, так требует @tr() по умолчанию.
msgid ""
msgstr ""
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

