# --- Анализ программы ---

msgctxt "MainWindow"
msgid "Анализ программы"
msgstr "Program analysis"

msgctxt "MainWindow"
msgid "Выберите программу, запишите сеанс и посмотрите, что "
msgstr "Pick a program, record a session and see what "

msgctxt "MainWindow"
msgid "упиралось в потолок. Мгновенные числа тут бесполезны: "
msgstr "hit its ceiling. Instant numbers are useless here: "

msgctxt "MainWindow"
msgid "просадка длится секунду, и к моменту, когда вы "
msgstr "a stutter lasts a second, and by the time you "

msgctxt "MainWindow"
msgid "переключитесь, всё уже прошло."
msgstr "switch over, it is already gone."

msgctxt "MainWindow"
msgid "выберите игру или программу"
msgstr "pick a game or a program"

msgctxt "MainWindow"
msgid "Остановить"
msgstr "Stop"

msgctxt "MainWindow"
msgid "Записать"
msgstr "Record"

msgctxt "MainWindow"
msgid "Видеокарта"
msgstr "Graphics card"

